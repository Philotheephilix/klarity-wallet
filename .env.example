# Destination RPC for Base Sepolia (tunnelled through the anon transport).
VITE_RPC_URL=https://sepolia.base.org

# ERC-8244 contract that serves the wallet UI via html().
# Leave unset in dev to load the bundled local walletDocument.html instead.
# VITE_WALLET_CONTRACT=0x...

# Pimlico bundler API key for Base Sepolia (free tier). Needed to send userOps.
# Get one at https://dashboard.pimlico.io
# VITE_PIMLICO_KEY=pim_...

# Set to 1 to route through real Tor (tor-js specifier) instead of dev passthrough.
# VITE_USE_TOR=0
